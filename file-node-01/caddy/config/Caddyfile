{
	email {$ACME_EMAIL}
	acme_ca https://dv.acme-v02.api.pki.goog/directory
	acme_eab {
		key_id {file./run/secrets/gts_eab_key_id}
		mac_key {file./run/secrets/gts_eab_hmac_key}
	}
	key_type p256
}

(tls-config) {
	tls {
		dns cloudflare {file./run/secrets/cf_api_token}
	}
}

*.o11y.internal.darak.dev {
	import tls-config

	@metrics host metrics.o11y.internal.darak.dev
	handle @metrics {
		reverse_proxy victoria-metrics:8428
	}

	@logs host logs.o11y.internal.darak.dev
	handle @logs {
		reverse_proxy victoria-logs:9428
	}

	handle {
		respond "not found" 404
	}
}
